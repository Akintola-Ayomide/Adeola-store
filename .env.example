# ---------------------------------------------------------------------------
# ÀRÌKÉ — environment variables
# Copy to .env.local and fill in real values. Never commit .env.local.
# ---------------------------------------------------------------------------

# Sanity CMS. Leave blank to run the local demo catalogue.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-02-19

# Server-only tokens. Do NOT prefix these with NEXT_PUBLIC_.
# Read token is optional for a public dataset, required for a private dataset.
SANITY_API_READ_TOKEN=
# Used only by `npm run seed` to publish the demo catalogue to Sanity.
SANITY_API_WRITE_TOKEN=

# Public site URL, without a trailing slash. Used for canonical URLs,
# sitemap.xml, robots.txt and Open Graph metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form delivery.
# Leave blank for the honest WhatsApp handoff (no email is claimed as sent).
# When set, the API POSTs the enquiry JSON to this URL.
CONTACT_WEBHOOK_URL=
# Optional bearer token sent as `Authorization: Bearer ...` to the webhook.
CONTACT_WEBHOOK_SECRET=

# Optional secret used by a deploy hook to revalidate Sanity content.
SANITY_REVALIDATE_SECRET=
